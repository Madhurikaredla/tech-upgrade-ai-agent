# App
APP_NAME=ai-platform
APP_VERSION=0.1.0
DEBUG=false

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Logfire — leave blank to disable remote export
LOGFIRE_TOKEN=
LOGFIRE_PROJECT_NAME=ai-platform

# NestJS / Auth API
NESTJS_BASE_URL=https://api.portal.dev.divami.com
NESTJS_TIMEOUT=30.0
NESTJS_MAX_RETRIES=3

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dbname

# AI models — priority: Google → Groq → Anthropic (first key found wins)
# Azure OpenAI (optional — uncomment to use)
# AZURE_OPENAI_MODEL_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2025-01-01-preview
# AZURE_OPENAI_MODEL_KEY=
# AZURE_OPENAI_MODEL_API_VERSION=2024-04-01-preview

# Google Gemini — https://aistudio.google.com/app/apikey  (free: 10 RPM / 250 RPD)
GOOGLE_API_KEY=

# Groq — https://console.groq.com  (free: 30 RPM / 14,400 RPD — recommended for development)
GROQ_API_KEY=

# Anthropic / OpenAI (optional — leave blank if not used)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google model name (used when GOOGLE_API_KEY is set)
# Options: gemini-2.5-flash (fast+cheap), gemini-2.5-pro (best quality)
DEFAULT_MODEL=gemini-2.5-flash

# Groq model name (used when GROQ_API_KEY is set and GOOGLE_API_KEY is not)
# Options: qwen/qwen3-32b (recommended), meta-llama/llama-4-scout-17b-16e-instruct, openai/gpt-oss-120b
# Note: model IDs on Groq require the namespace prefix (e.g. qwen/, meta-llama/, openai/)
GROQ_MODEL=qwen/qwen3-32b
